# 忽略操作系统与编辑器临时文件
.DS_Store
Thumbs.db
.vscode/
.idea/
*.pyc
__pycache__/

# 彻底移除遗留的 Obsidian 配置目录
.obsidian/

# 【核心隐私保护】忽略用户本地 vault/ 下的所有私人境遇与真实决策数据
# 仅保留目录占位符，防止用户误将个人隐私推送到公开 GitHub 仓库
vault/*
!vault/.gitkeep
!vault/L1_atlas/
vault/L1_atlas/*
!vault/L1_atlas/.gitkeep
!vault/L2_decisions/
vault/L2_decisions/*
!vault/L2_decisions/.gitkeep
!vault/L3_archive/
vault/L3_archive/*
!vault/L3_archive/.gitkeep
!vault/inbox/
vault/inbox/*
!vault/inbox/.gitkeep
